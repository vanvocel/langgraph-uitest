# Copy to .env and fill in real values. Never commit .env.

BASE_URL=https://main.z-niu.com

# default_tester (account_ref)
TEST_USERNAME=your_phone
TEST_PASSWORD=your_password

# LLM (Phase 4 compile). Leave empty to use offline stub.
LLM_PROFILE=deepseek
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=

# Notify report (config/notify.yaml). Feishu app-bot file upload needs all three.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
# Public base URL that serves runs/ (no trailing slash). Example after nginx deploy:
# REPORT_BASE_URL=https://uitest.example.com/reports
# -> https://uitest.example.com/reports/MG0557/allure-report.html
REPORT_BASE_URL=
